# Maintainer: zccrs <zhangjide@deepin.org>
pkgname=dtk6declarative-git
pkgver=6.0.48
pkgrel=1
pkgdesc='Deepin Toolkit, declarative module for DDE look and feel'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/dtk6declarative"
license=('LGPL-3.0-or-later')
depends=('dtk6core-git' 'dtk6gui-git' 'dtkcommon-git' 'qt6-base' 'qt6-declarative' 'qt6-5compat' 'libglvnd' 'libgcc' 'libstdc++' 'glibc')
# Qt 6.12 的 qrhivulkan_p.h 需要 Vulkan 头文件 / Qt 6.12's qrhivulkan_p.h needs the Vulkan headers.
makedepends=('git' 'cmake' 'ninja' 'qt6-tools' 'qt6-shadertools' 'vulkan-headers')
provides=("dtk6declarative=$pkgver")
conflicts=('dtk6declarative')
groups=('deepin-git')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DMKSPECS_INSTALL_DIR=lib/qt6/mkspecs/modules \
    -DQML_INSTALL_DIR=lib/qt6/qml \
    -DBUILD_EXAMPLES=OFF \
    -DBUILD_TESTING=OFF \
    -DBUILD_DOCS=OFF
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
}
